# ============ 飞书应用凭据 ============
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# websocket（长连，无需公网）或 webhook
FEISHU_CONNECTION_MODE=websocket
# 国内 lark / 海外 feishu
FEISHU_DOMAIN=feishu

# ============ Bridge ↔ Server 通信 ============
BRIDGE_WS_HOST=0.0.0.0
BRIDGE_WS_PORT=8765
# 配对 token：逗号分隔可分发给多台客户端。建议 openssl rand -hex 24
BRIDGE_PAIR_TOKENS=please-change-me

# ============ 飞书白名单（可选）============
# 仅允许这些 open_id 使用 /cc 命令，逗号分隔；为空表示不限制
FEISHU_ALLOWED_USERS=

# ============ 日志 ============
LOG_LEVEL=INFO

# ============ 权限请求展示模式 ============
# false（默认）：决策后权限区消失，卡片继续流式更新
# true：决策后保留权限区，便于审计
FEISHU_CC_PERM_KEEP_HISTORY=false
